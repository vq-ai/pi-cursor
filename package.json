{
  "name": "pi-cursor",
  "version": "0.1.0",
  "description": "Cursor-style workflows for the Pi coding agent: Ask/Plan/Debug/Implement modes, rules, skills, custom agents, parallel/background sub-agents, hooks, approvals, checkpoints and a Cursor-like TUI.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "cursor",
    "subagents",
    "agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vq-ai/pi-cursor.git"
  },
  "files": [
    "src",
    "agents",
    "skills",
    "prompts",
    "themes",
    "docs",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pi": "pi -e ./src/index.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^24.0.0",
    "@xterm/headless": "^5.5.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
